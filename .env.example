# Dev dùng http://localhost:5173. Với npm start tại máy, dùng http://localhost:8787.
# Production phải đúng origin HTTPS, không có dấu / ở cuối.
PUBLIC_ORIGIN=http://localhost:5173
HOST=127.0.0.1
PORT=8787
DB_PATH=./data/thuong-em.sqlite

# Chạy npm run keys và điền cả hai khóa. Không đổi cặp khóa khi đang có đăng ký.
VAPID_SUBJECT=mailto:ban@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Tạo bằng lệnh trong README, dài ít nhất 24 ký tự.
ACTIVATION_CODE=
