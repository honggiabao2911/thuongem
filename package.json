{
  "name": "thuong-em",
  "version": "1.0.0",
  "description": "",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "dev": "vite --host localhost --strictPort",
    "api": "node --env-file-if-exists=.env server/main.ts",
    "start": "node --env-file-if-exists=.env server/main.ts",
    "tick": "node --env-file-if-exists=.env server/main.ts tick",
    "build": "tsc --noEmit && vite build && node deploy/precache.mjs",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "keys": "web-push generate-vapid-keys --json",
    "build:pages": "tsc --noEmit && vite build --base=/thuongem/ --outDir docs && node deploy/precache.mjs docs /thuongem/"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "dependencies": {
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@js-temporal/polyfill": "^0.5.1",
    "lucide-react": "^1.79.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  }
}
